{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(//**/.env)",
      "Read(//**/.env.local)",
      "Read(//**/.env.production)",
      "Read(//**/.env.*.local)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.azure/**)",
      "Read(~/.docker/config.json)",
      "Read(~/.npmrc)",
      "Read(~/.git-credentials)",
      "Read(~/.claude/.credentials.json)",
      "Read(//**/*.pem)",
      "Read(//**/id_rsa*)",
      "Read(//**/id_ed25519*)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git push)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(git tag *)",
      "Bash(gh pr merge *)",
      "Bash(gh release *)",
      "Bash(gh repo delete *)",
      "Bash(npm publish *)",
      "Bash(pnpm publish *)",
      "Bash(yarn publish *)",
      "Bash(composer publish *)",
      "Bash(docker push *)",
      "Bash(rm -rf *)",
      "Bash(rm -r *)",
      "Bash(php artisan migrate:fresh *)",
      "Bash(php artisan migrate:reset *)",
      "Bash(php artisan migrate:rollback *)",
      "Bash(php artisan db:wipe *)",
      "Bash(terraform apply *)",
      "Bash(terraform destroy *)",
      "Bash(kubectl apply *)",
      "Bash(kubectl delete *)",
      "Bash(vercel *)",
      "Bash(netlify deploy *)",
      "Bash(firebase deploy *)",
      "Bash(wrangler deploy *)",
      "PowerShell(git push *)",
      "PowerShell(git push)",
      "PowerShell(git reset --hard *)",
      "PowerShell(gh pr merge *)",
      "PowerShell(gh release *)",
      "PowerShell(npm publish *)",
      "PowerShell(Remove-Item *)",
      "PowerShell(php artisan migrate:fresh *)",
      "PowerShell(php artisan db:wipe *)"
    ],
    "disableBypassPermissionsMode": "disable"
  },
  "model": "opusplan"
}
